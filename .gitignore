# Dependencies - ALWAYS ignore node_modules (industry standard)
node_modules/
**/node_modules/

# Prisma generated files - regenerated from schema.prisma
**/generated/
**/generated/prisma/

# Build artifacts
**/lambda_build/
**/prisma-layer.zip
**/lambda-post-confirmation.zip
**/.next/
**/out/
**/build/

# Terraform state files (contain sensitive data)
**/.terraform/
**/*.tfstate
**/*.tfstate.backup
**/.terraform.lock.hcl

# Environment files
.env
.env*.local

# OS files
.DS_Store
*.pem

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

